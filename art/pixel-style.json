{
  "version": 1,
  "name": "CHA0S Mech Wars Phase 0 Canon",
  "logicalPixelWorldPx": 4,
  "sourceGrids": {
    "actorsAndProps": [8, 8],
    "structures": [16, 16],
    "bosses": "native masks scaled to 48x48 without smoothing"
  },
  "palette": {
