    "menuBlueBlack": "#051015",
    "gray1": "#111111",
    "gray2": "#333333",
    "gray3": "#555555",
    "gray4": "#888888",
    "gray5": "#aaaaaa",
    "gray6": "#cccccc",
    "warning": "#ea9e22",
    "hpDark": "#001020",
    "hpRampEnd": "#0088aa"
  },
  "ramps": {
    "hud": ["#001020", "#0088aa", "#00eaff", "#ffffff"],
    "danger": ["#550000", "#880000", "#ff0000", "#ffffff"],
    "fire": ["#ff4400", "#ff6600", "#ff9900", "#ffaa00", "#ffff00"],
    "forest": ["#051005", "#55bb55", "#22dd66", "#55ff55"],
    "ruins": ["#101520", "#333355", "#776666", "#888899"],
    "dungeon": ["#1a0505", "#330000", "#554444", "#aa00ff"]
  },
  "rules": {
    "outlines": "No automatic outline. Apply only when an asset recipe explicitly requests one.",
    "shading": "Flat single-color silhouettes by default. Preserve authored ramps; never introduce interpolated colors.",
    "alpha": [0, 255],
    "detail": "One source cell is the minimum detail. Avoid sub-cell antialiasing in generated bitmap data.",
    "anchors": {
      "default": [0.5, 1],
      "projectile": [0.5, 0.5],
      "tile": [0, 0],
      "screen": [0, 0]
    },
    "shadow": {
      "shape": "ellipse",
      "nativeSize": [32, 16],
      "opacity": 0.5,
      "anchor": [0.5, 0.5]
    },
    "compositing": {
      "shieldFillAlpha": 0.15,
      "shadowAlpha": 0.5,
      "pickupAuraAlpha": 0.5,
      "gridAlpha": 0.1,
      "forestDarknessAlpha": 0.1,
      "ruinsDungeonDarknessAlpha": 0.3,
      "bossPanelAlpha": 0.8,
      "hudPanelAlpha": 0.85,
      "menuPanelAlpha": 0.9,
      "screenPanelAlpha": 0.98
    },
    "animation": "Integer-position source pixels, nearest-neighbor scaling, authored pulse/flash timing only.",
    "scaling": "Nearest-neighbor only; image smoothing must remain disabled."
  },
  "categories": {
    "actor": "8x8 source where authored; render at 32x32. Larger legacy masks keep their native grid and scale to gameplay bounds.",
    "boss": "Preserve existing native mask and 48x48 gameplay bounds. No sprite redesign.",
    "structure": "16x16 source for 64x64 walls; nearest-neighbor only.",
    "projectile": "Use gameplay dimensions and centered anchor; flat palette colors.",
    "pickup": "24x24 core with existing 34x34 half-alpha aura and monospace glyph.",
    "effect": "Preserve authored primitive geometry, blend mode, alpha, and timing.",
    "background": "Flat biome ground plus 100 world-pixel cyan grid and red boundary.",
    "hud": "DOM/CSS remains authoritative for layout; colors and rhythm come from generated contract tokens."
  },
  "rhythm": {
    "logicalPixel": "4px",
    "micro": "5px",
    "small": "10px",
    "medium": "20px",
    "large": "30px",
    "hudGap": "20px",
    "hudPadding": "30px",
    "scanline": "4px"
  },
  "nearestNeighbor": {
    "canvasImageSmoothingEnabled": false,
    "cssImageRendering": "pixelated"
  }
}
